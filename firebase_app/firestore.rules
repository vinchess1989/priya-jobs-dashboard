rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthorized() {
      return request.auth != null && (
        request.auth.token.email == "munchnambiar@gmail.com"
        // TODO: add Priya's real email here once known, e.g.:
        // || request.auth.token.email == "priya@example.com"
      );
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId && isAuthorized();
    }

    match /shared_state/{docId} {
      allow read, update: if true;
      allow create, delete: if isAuthorized();
    }

    match /user_feedback/{docId} {
      allow read, update: if true;
      allow create, delete: if isAuthorized();
    }
  }
}
